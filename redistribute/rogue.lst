33CB 221D             (         main.asm):01536                 bhi notaggro@
33CD D13E             (         main.asm):01537                 cmpb player+1   ; is upper edge of aggro aread below player?
33CF 2219             (         main.asm):01538                 bhi notaggro@
33D1 EC42             (         main.asm):01539                 ldd 2,u         ; xcenter, ycenter
33D3 AB44             (         main.asm):01540                 adda 4,u        ; a = right edge of aggro area
33D5 EB45             (         main.asm):01541                 addb 5,u        ; b = lower edge of aggro area
33D7 5C               (         main.asm):01542                 incb
33D8 5C               (         main.asm):01543                 incb
33D9 913D             (         main.asm):01544                 cmpa player     ; is right edge of aggro area to left of player?
33DB 250D             (         main.asm):01545                 blo notaggro@
